[Unit]
Description=Receipt Tracker Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/receipt-tracker
ExecStart=/home/ubuntu/receipt-tracker/.venv/bin/python bot.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/receipt-tracker/.env

[Install]
WantedBy=multi-user.target
