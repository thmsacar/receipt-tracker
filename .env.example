# ==============================================================================
# Configuration pour le suivi des tickets de caisse (Gemini Flash API)
# ==============================================================================

# Clé API Google Gemini (Obtenez une clé gratuite sur https://aistudio.google.com/)
GEMINI_API_KEY=votre_cle_api_ici

# Modèle Gemini Flash (par défaut: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
